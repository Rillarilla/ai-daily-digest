# Environment Configuration
# Copy this file to .env and fill in your values

# Vertex AI service account JSON (optional, for AI summaries)
GOOGLE_SA_JSON=

# Standalone SMTP helper only (not used by the scheduled digest)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password

# Recipient email
TO_EMAIL=rillahai@gmail.com

# Feishu configuration for daily delivery
# Create an app at https://open.feishu.cn/app
FEISHU_APP_ID=cli_...
FEISHU_APP_SECRET=...
# Optional: Folder token to store docs in specific folder
FEISHU_FOLDER_TOKEN=...
# Target chat ID for daily delivery (starts with oc_...)
FEISHU_BOT_CHAT_ID=oc_...
